# Copy to .env at the repository root only when changing defaults.
PORT=3000
HOST=127.0.0.1
NODE_ENV=development
# Use array for the preserved implementation; selection takes effect on server restart.
MATCHING_ENGINE=price-tree
# Set false to start with empty order books.
ENABLE_DEMO_LIQUIDITY=true
SESSION_TTL_MS=86400000
# Set true only when serving the browser over HTTPS.
COOKIE_SECURE=false
# Omit to allow localhost/127.0.0.1 on 5173 and PORT automatically.
# ALLOWED_ORIGINS=https://stock.example
